# --- Banco de dados ---
# Em dev local (docker-compose sobe o Postgres na porta 5432):
DATABASE_URL="postgresql://glchub:glchub@localhost:5432/glchub?schema=public"

# --- Segurança ---
# Gere com: openssl rand -hex 32
AUTH_SECRET="troque-me"
# Senha do painel admin (Fase 1; na Fase 2 vira conta com role admin)
ADMIN_PASSWORD="troque-me"

# --- Planilha fonte (GLC - Circuito SP) ---
SHEET_ID="1m4bGPteefWIQfjILnZ8iUbHUZj05hxoe_N907GM5c68"

# --- Worker de sincronização ---
# Intervalo entre syncs, em minutos (1h a 6h; padrão 120)
SYNC_INTERVAL_MINUTES="120"

# --- App ---
TZ="America/Sao_Paulo"
# URL pública (usada em metadados/OG)
SITE_URL="http://localhost:3000"

# Popular dados de exemplo no seed (útil em dev, sem depender da planilha)
SEED_SAMPLE="false"
