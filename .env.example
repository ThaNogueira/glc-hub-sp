# --- Banco de dados ---
# Em dev local (docker-compose sobe o Postgres na porta 5432):
DATABASE_URL="postgresql://glchub:glchub@localhost:5432/glchub?schema=public"

# --- Segurança ---
# Gere com: openssl rand -hex 32
AUTH_SECRET="troque-me"
# Senha do painel admin (Fase 1; na Fase 2 vira conta com role admin)
ADMIN_PASSWORD="troque-me"

# --- Planilha fonte (GLC - Circuito SP) ---
SHEET_ID="1m4bGPteefWIQfjILnZ8iUbHUZj05hxoe_N907GM5c68"

# --- Worker de sincronização ---
# Intervalo entre syncs, em minutos (1h a 6h; padrão 120)
SYNC_INTERVAL_MINUTES="120"
# Atualização da base de cartas (pokemon-tcg-data), em horas (padrão 168 = semanal)
CARDS_REFRESH_HOURS="168"

# --- Login social (opcional; sem as chaves, os botões não aparecem) ---
# Google: https://console.cloud.google.com/apis/credentials — OAuth client ID (Web)
#   Redirect URI: {SITE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Discord: https://discord.com/developers/applications — OAuth2
#   Redirect URI: {SITE_URL}/api/oauth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- E-mail transacional (só para "esqueci minha senha"; cadastro não pede
# confirmação). Sem SMTP_URL, o link de reset sai no log do container web.
# Ex.: smtp://usuario:senha@smtp.provedor.com:587
SMTP_URL=""
MAIL_FROM="GLC Hub SP <no-reply@seudominio.com.br>"

# --- App ---
# Porta do host onde o web fica exposto (127.0.0.1 apenas; o Caddy faz o proxy).
# Mude se outro serviço da VPS já usa a 3000.
WEB_PORT="3000"
TZ="America/Sao_Paulo"
# URL pública (usada em metadados/OG)
SITE_URL="http://localhost:3000"

# Popular dados de exemplo no seed (útil em dev, sem depender da planilha)
SEED_SAMPLE="false"
